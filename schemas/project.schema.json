{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "XGO-Duck Community project",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "summary", "description", "author", "category", "repository", "compatibility", "installation", "updated"],
  "properties": {
    "name": { "type": "string", "minLength": 2, "maxLength": 70 },
    "summary": { "type": "string", "minLength": 5, "maxLength": 150 },
    "description": { "type": "string", "minLength": 20, "maxLength": 12000 },
    "author": {
      "type": "object", "additionalProperties": false, "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 70 },
        "url": { "$ref": "#/definitions/httpsUrl" }
      }
    },
    "category": { "enum": ["structure", "firmware", "motion-model", "av-interaction"] },
    "repository": { "$ref": "#/definitions/httpsUrl" },
    "image": { "type": "string", "maxLength": 2048, "pattern": "^(https://|assets/projects/)" },
    "image_alt": { "type": "string", "minLength": 2, "maxLength": 200 },
    "gallery": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["image", "alt"],
        "properties": {
          "image": { "type": "string", "pattern": "^(https://|assets/projects/)", "maxLength": 2048 },
          "alt": { "type": "string", "minLength": 2, "maxLength": 200 }
        }
      }
    },
    "video": { "$ref": "#/definitions/httpsUrl" },
    "documentation": { "$ref": "#/definitions/httpsUrl" },
    "issues": { "$ref": "#/definitions/httpsUrl" },
    "license": { "type": "string", "minLength": 1, "maxLength": 100 },
    "tags": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 30 } },
    "compatibility": {
      "type": "object", "additionalProperties": false, "required": ["hardware", "firmware", "notes"],
      "properties": {
        "hardware": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "firmware": { "type": "string", "minLength": 1, "maxLength": 200 },
        "notes": { "type": "string", "minLength": 5, "maxLength": 2000 }
      }
    },
    "installation": { "type": "array", "minItems": 1, "maxItems": 15, "items": { "type": "string", "minLength": 5, "maxLength": 1500 } },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "dependencies": { "image": ["image_alt"] },
  "definitions": {
    "httpsUrl": { "type": "string", "maxLength": 2048, "pattern": "^https://[^\\s]+$" }
  }
}
