{
  "name": "xgoduck-community",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A PR-powered directory of independently maintained XGO-Duck projects.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/serve.mjs --build --watch",
    "dev:demo": "node scripts/serve.mjs --build --watch --demo",
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build.mjs --demo",
    "preview": "node scripts/serve.mjs",
    "validate": "node scripts/validate.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:build": "node scripts/check-build.mjs",
    "test": "node --test",
    "check": "npm run validate && npm test && npm run build && npm run check:build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.8.1"
  }
}
